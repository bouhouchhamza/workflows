      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst msg = body.message ? body.message.toLowerCase() : \"\";\n\nconst userConfirmation = msg.includes(\"oui\") || msg.includes(\"ok\") || msg.includes(\"confermer\");\n\nreturn [\n  {\n    json: {\n      phone: body.phone,\n      name: body.name || null,\n      message: body.message || \"\",\n      channel: body.channel || \"whatsapp\",\n      user_confirmation: userConfirmation,\n    },\n  },\n];"
      },
