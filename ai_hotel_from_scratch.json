        "jsCode": "// جلب البيانات من webhook input\nconst phone = $json[\"body\"][\"phone\"]?.trim() || \"\";\nconst name = $json[\"body\"][\"name\"]?.trim() || \"Guest\";\nlet channel = $json[\"body\"][\"channel\"]?.trim()?.toLowerCase() || \"web\";\nlet message = $json[\"body\"][\"message\"]?.trim() || \"\";\n\n// allowed channels validation\nconst allowedChannels = [\"whatsapp\", \"web\"];\nif (!allowedChannels.includes(channel)) channel = \"web\";\n\n// lowercase normalization for easier parsing (optional)\nmessage = message.toLowerCase();\n\nreturn [\n  {\n    json: {\n      phone: phone,\n      name: name,\n      channel: channel,\n      message: message\n    }\n  }\n];"
      },
