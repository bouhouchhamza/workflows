      "parameters": {
        "jsCode": "const rooms = $input.all().map(i => i.json);\n\nlet text = \"ها الغرف المتوفرة عندنا:\\n\\n\";\n\nif (!rooms.length) {\n  text = \"سمح ليا، دابا ما كايناش غرف متوفرة.\";\n} else {\n  for (const room of rooms) {\n    text += `🏨 ${room.name} - ${room.type || ''}\\n`;\n    text += `👥 ${room.capacity || ''} أشخاص\\n`;\n    text += `💰 ${room.price || ''} MAD / night\\n\\n`;\n  }\n}\n\nreturn [{ json: { reply: text } }];"
      },
